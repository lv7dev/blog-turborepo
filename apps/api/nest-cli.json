{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "builder": {
      "type": "webpack",
      "options": {
        "configPath": "webpack.config.cjs"
      }
    },
    "deleteOutDir": true,
    "assets": [
      {
        "include": "../generated/prisma/package.json",
        "outDir": "dist/generated/prisma"
      }
    ]
  }
}
